{
  "manifest_version": 3,
  "name": "Polar Workout Importer",
  "version": "1.0.0",
  "key": "",
  "description": "Automates creation of phased target workouts from Polar Workout Generator in Polar Flow Web.",
  "permissions": [
    "storage",
    "tabs",
    "clipboardRead",
    "activeTab"
  ],
  "host_permissions": [
    "https://flow.polar.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://polar-workout-generator.ai.studio/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Polar Workout Importer"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.polar.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
